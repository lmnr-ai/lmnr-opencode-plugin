{
  "name": "@lmnr-ai/opencode-plugin",
  "version": "0.1.0",
  "description": "Laminar AI plugin for OpenCode",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "import": "./dist/index.d.mts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmnr-ai/lmnr-opencode-plugin.git"
  },
  "keywords": [
    "laminar",
    "lmnr",
    "opencode",
    "plugin",
    "tracing",
    "opentelemetry"
  ],
  "author": "founders@lmnr.ai",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/lmnr-ai/lmnr-opencode-plugin/issues"
  },
  "homepage": "https://github.com/lmnr-ai/lmnr-opencode-plugin#README",
  "dependencies": {
    "@lmnr-ai/lmnr": "^0.8.15",
    "@opencode-ai/plugin": "^1.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "dotenv": "^17.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.0",
    "eslint": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsdown": "^0.18.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.2"
  }
}
